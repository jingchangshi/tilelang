                T.writes()
                T.sblock_attr({"tl.vf_source_index": T.int64(0)})
                T.attr("simdvf", "tl.simdvf_scope", 1)
                mask: T.boolx256 = T.tl.simd.pset(32, "PAT_ALL")
                for i in range(128):
                    a_reg: T.float32x64 = T.tl.simd.vld(T.tvm_access_ptr(T.type_annotation("float32"), buf_dyn_shmem.data, i * 64, 64, 1), "NORM")
                    b_reg: T.float32x64 = T.tl.simd.vld(T.tvm_access_ptr(T.type_annotation("float32"), buf_dyn_shmem.data, i * 64 + 16384, 64, 1), "NORM")
                    result: T.float32x64 = T.tl.simd.vadd(a_reg, b_reg, mask, "MODE_ZEROING")
                    T.tl.simd.vsts(T.tvm_access_ptr(T.type_annotation("float32"), buf_dyn_shmem.data, i * 64 + 32768, 64, 2), result, mask, "NORM_B32")
