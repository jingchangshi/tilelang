                    a_reg: T.float32x64 = T.tl.simd.vld(T.address_of(buf_dyn_shmem_3[i * 64]), "NORM")
                    buf_dyn_shmem_4 = T.Buffer((i * 64 + 16384 + 1,), data=buf_dyn_shmem.data, scope="shared.dyn")
                    b_reg: T.float32x64 = T.tl.simd.vld(T.address_of(buf_dyn_shmem_4[i * 64 + 16384]), "NORM")
