@I.ir_module
class Module:
    @T.prim_func
    def main_kernel(A: T.handle("float32", "global"), B: T.handle("float32", "global"), C: T.handle("float32", "global")):
        T.func_attr({"calling_conv": 2, "dyn_shared_memory_buf": T.int64(196608), "target": T.target({"keys": ["ascend"], "kind": "ascend", "launch_grid_only": True, "max_vector_bits": 64, "supports_kernel_status_return": False, "supports_vector_predicate": True, "tag": ""}), "thread_extent": {"blockIdx.x": 64}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "tirx.use_dyn_shared_memory"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [0, 1]})
        bx = T.launch_thread("blockIdx.x", 64)
        buf_dyn_shmem = T.alloc_buffer((T.int64(196608),), "uint8", scope="shared.dyn")
        a = T.decl_buffer((16384,), data=buf_dyn_shmem.data, scope="shared.dyn")
        b = T.decl_buffer((16384,), data=buf_dyn_shmem.data, scope="shared.dyn")
        c = T.decl_buffer((16384,), data=buf_dyn_shmem.data, scope="shared.dyn")
        with T.sblock("VECTOR", no_realize=True):
            T.reads()
            T.writes()
